# pydantic-ai model string. The code default is anthropic:claude-haiku-4-5.
CHAT_MODEL=anthropic:claude-haiku-4-5
# Optional second model. Used only when this is non-empty.
CHAT_FALLBACK_MODEL=

# Read only when a model string starts with litellm:
LITELLM_BASE_URL=
LITELLM_API_KEY=

# Provider SDKs read these. Leave the ones you are not using blank.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

ALLOWED_ORIGIN=https://mindofshaun.com
# development also allows http://localhost and http://127.0.0.1. production does not.
APP_ENV=development
# Trusted proxy hops in front of the app. 0 ignores X-Forwarded-For.
TRUSTED_PROXY_COUNT=2
DAILY_REQUEST_CAP=400

# Built Vite files. Empty uses ../dist from a checkout. The image sets /app/static.
STATIC_DIR=
